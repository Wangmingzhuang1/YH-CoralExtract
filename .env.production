# 批次配置快照（无密钥）：YH-CoralGeo v1.1.0 图组批次
# 归档汇总表 SHA-256: d2ad45f18b3b8bab60b6bfda181ca6ac2c01394e68b6e15ef27dca0ca1a695a8
# 本文件钉住该批次各轮模型版本与调用设置，供精确复现；密钥与专属端点另见 .env.example。
# 用法：将本文件非密钥项覆盖到 .env，再填入 LLM_API_KEY / JUDGE_API_KEY。

# 提取生成档（复杂推理；思考模式关闭以复用缓存）
LLM_MODEL_MAX=qwen3.8-max
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=0

# 轻量档（正文元数据）
LLM_MODEL_FLASH=qwen3.8-flash

# 论文级复核档
REVIEW_MODEL=qwen4-max-preview
REVIEW_ENABLE_THINKING=false
REVIEW_THINKING_BUDGET=0

# Jev 判卷层：本地判别式置信度模型（OpenAI 兼容端点）
JUDGE_BACKEND=typesafe
JUDGE_BASE_URL=http://localhost:11434/v1/systemone
JUDGE_MODEL=tev1:4b
JUDGE_PASS_THRESHOLD=0.60
JUDGE_FAIL_THRESHOLD=0.30
JUDGE_REVIEW_ONLY=false
JUDGE_TIMEOUT=60

# 低分候选升级重判（第一轮映射核验）
JUDGE_ESCALATE=true
JUDGE_ESCALATE_MODEL=deepseek-v4-pro
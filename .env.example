# 大模型调用配置（OpenAI兼容端点）
# 默认示例为按量付费端点；如使用 Token Plan 请替换为对应专属端点与 sk-sp 密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_MAX=qwen3.8-max
LLM_MODEL_FLASH=qwen3.8-flash
REVIEW_MODEL=max
REVIEW_ENABLE_THINKING=false

# Jev判卷层（置信度门禁）：off=不启用 | typesafe=TypeSafe官方API | ark=火山方舟决策评估
JUDGE_BACKEND=off
JUDGE_API_KEY=
JUDGE_MODEL=jev-latest
JUDGE_PASS_THRESHOLD=0.60
JUDGE_FAIL_THRESHOLD=0.40
JUDGE_REVIEW_ONLY=true
JUDGE_ESCALATE=false

PAPER_ASSISTANT_OUTPUT_PATH=./output

# 代理配置（可选）
HTTP_PROXY=
HTTPS_PROXY=
